# =================================================================
# Connexa (Chatify Backend) - Environment Variables Template
# Copy this file to .env and fill in your actual credentials
# =================================================================

# -----------------------------------------------------------------
# 1. Database (PostgreSQL)
# -----------------------------------------------------------------
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password
DB_JDBC_URL=jdbc:postgresql://localhost:5432/chatify

# -----------------------------------------------------------------
# 2. JWT Authentication
# -----------------------------------------------------------------
JWT_SIGN_KEY_LOCATION=jwt/privateKey.pem
JWT_VERIFY_PUBLICKEY_LOCATION=jwt/publicKey.pem
JWT_ISSUER=chatify-jwt

# -----------------------------------------------------------------
# 3. Cloudinary (Media Upload Storage)
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
# -----------------------------------------------------------------
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# -----------------------------------------------------------------
# 4. AI Chatbot / LangChain4j (Groq API)
# -----------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# -----------------------------------------------------------------
# 5. Gemini AI (Optional / Alternative)
# -----------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL_NAME=gemini-1.5-flash

# -----------------------------------------------------------------
# 6. CORS / Server Configuration
# -----------------------------------------------------------------
CORS_ORIGINS=*
