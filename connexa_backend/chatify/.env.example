# Copy to .env and replace values locally. Never put real credentials here.
DB_USERNAME=postgres
DB_PASSWORD=
DB_URL=jdbc:postgresql://localhost:5432/chatify_db

# Cloudinary URL format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# Groq API key used by the configured OpenAI-compatible provider
GROQ_API_KEY=

# Keep private keys outside version control.
JWT_PRIVATE_KEY_LOCATION=jwt/privateKey.pem
JWT_PUBLIC_KEY_LOCATION=jwt/publicKey.pem
JWT_ISSUER=chatify-jwt
