# ==============================================================================
# HƯỚNG DẪN CẤU HÌNH MÔI TRƯỜNG DÀNH CHO TEAM
# Copy file này thành ".env.local" để kích hoạt cấu hình trên máy cá nhân:
#   cp .env.local.example .env.local
# File ".env.local" được Git bỏ qua (không lo bị conflict khi push code).
# ==============================================================================

# [CHẾ ĐỘ THIẾT KẾ UI - KHÔNG CẦN BACKEND]
# - true : Bỏ qua kiểm tra JWT/Auth (Vào thẳng trang Admin/UI để thiết kế mà không cần chạy backend)
# - false: Kiểm tra Auth thực tế qua JWT và Backend API
NEXT_PUBLIC_BYPASS_AUTH=true

# [CHẾ ĐỘ MOCK DATA DASHBOARD ADMIN]
# - true : Dùng dữ liệu mẫu cho Dashboard khi Backend chưa có hoặc chưa chạy (có gắn nhãn Demo rõ ràng)
# - false: Luôn gọi Backend Quarkus thật, nếu API lỗi sẽ hiện thông báo lỗi và nút "Thử lại", không thay số liệu giả
NEXT_PUBLIC_ADMIN_DASHBOARD_MOCK=true

# [CHẾ ĐỘ MOCK DATA QUẢN LÝ BÀI VIẾT ADMIN]
# - true : Dùng dữ liệu mẫu cho module Quản lý bài viết (Post Moderation) phục vụ thiết kế UI
# - false: Gọi API Backend Quarkus thật, nếu lỗi sẽ hiện thông báo lỗi và nút "Thử lại", không thay số liệu giả
NEXT_PUBLIC_ADMIN_POSTS_MOCK=true

# [CHẾ ĐỘ MOCK DATA XỬ LÝ BÁO CÁO VI PHẠM ADMIN]
# - true : Dùng dữ liệu mẫu cho module Báo cáo vi phạm (Report Management) phục vụ thiết kế UI
# - false: Gọi API Backend Quarkus thật, nếu lỗi sẽ hiện thông báo lỗi và nút "Thử lại", không thay số liệu giả
NEXT_PUBLIC_ADMIN_REPORTS_MOCK=true

# [CHẾ ĐỘ MOCK DATA QUẢN LÝ NGƯỜI DÙNG ADMIN]
# - true : Dùng dữ liệu mẫu cho module Quản lý người dùng & Kỷ luật phục vụ thiết kế UI
# - false: Gọi API Backend Quarkus thật, nếu lỗi sẽ hiện thông báo lỗi và nút "Thử lại", không thay số liệu giả
NEXT_PUBLIC_ADMIN_USERS_MOCK=true

# [CHẾ ĐỘ MOCK DATA QUẢN LÝ PHÒNG CHAT ADMIN]
# - true : Dùng dữ liệu mẫu cho module Quản lý phòng chat (Chatify Rooms)
# - false: Gọi API Backend Quarkus thật, nếu lỗi sẽ hiện thông báo lỗi và nút "Thử lại", không thay số liệu giả
NEXT_PUBLIC_ADMIN_ROOMS_MOCK=true

# [CHẾ ĐỘ MOCK DATA CÀI ĐẶT AI VÀ HỆ THỐNG ADMIN]
# - true : Dùng dữ liệu mẫu cho module Charles AI & Cài đặt hệ thống
# - false: Gọi API Backend Quarkus thật, nếu lỗi sẽ hiện thông báo lỗi và nút "Thử lại", không thay số liệu giả
NEXT_PUBLIC_ADMIN_AI_SETTINGS_MOCK=true

