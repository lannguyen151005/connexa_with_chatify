# ==============================================================================
# HƯỚNG DẪN CẤU HÌNH MÔI TRƯỜNG DÀNH CHO TEAM
# Copy file này thành ".env.local" để kích hoạt cấu hình trên máy cá nhân:
#   cp .env.local.example .env.local
# File ".env.local" được Git bỏ qua (không lo bị conflict khi push code).
# ==============================================================================

# [CHẾ ĐỘ THIẾT KẾ UI - KHÔNG CẦN BACKEND]
# - true : Bỏ qua kiểm tra JWT/Auth (Vào thẳng trang Admin/UI để thiết kế mà không cần chạy backend)
# - false: Kiểm tra Auth thực tế qua JWT và Backend API
NEXT_PUBLIC_BYPASS_AUTH=true

# [CHẾ ĐỘ MOCK DATA DASHBOARD ADMIN]
# - true : Dùng dữ liệu mẫu cho Dashboard khi Backend chưa có hoặc chưa chạy (có gắn nhãn Demo rõ ràng)
# - false: Luôn gọi Backend Quarkus thật, nếu API lỗi sẽ hiện thông báo lỗi và nút "Thử lại", không thay số liệu giả
NEXT_PUBLIC_ADMIN_DASHBOARD_MOCK=true
